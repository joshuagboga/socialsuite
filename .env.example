# ---- Core ----
PORT=3000
# The address people (and OAuth providers, and claude.ai) use to reach this app.
# Must be HTTPS and public for claude.ai connectors and for Instagram/Threads/Facebook image posts.
PUBLIC_URL=http://localhost:3000

# Shown on the privacy policy page at /privacy: who runs this site and how to reach them.
OPERATOR_NAME=
CONTACT_EMAIL=

# ---- Security ----
# Encrypts the social account tokens stored in the database. Required in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe. If you lose it, every account has to be reconnected.
# (On your own computer you can leave it empty: a development key is created in ./data.)
ENCRYPTION_KEY=

# Anyone can create an account by default. Set to false to close sign-ups
# (the very first account can always be created).
# ALLOW_SIGNUP=false

# Number of reverse proxies in front of the app (Caddy, nginx, Fly, Render...). Rate limits are per
# IP address, so this must be right. Defaults to 1 when PUBLIC_URL is https, otherwise 0.
# TRUST_PROXY=1
# Or name the header your host puts the visitor's address in (Fly.io: fly-client-ip,
# Cloudflare: cf-connecting-ip). Only use it when the app is reachable solely through that proxy.
# CLIENT_IP_HEADER=

# ---- Claude ----
# Powers "Write with Claude" in the composer. Each user can draft 30 times an hour.
ANTHROPIC_API_KEY=

# ---- Social platform apps (fill in the ones you use) ----
# Redirect URLs are PUBLIC_URL/auth/<platform>/callback, e.g. http://localhost:3000/auth/x/callback

# X: https://developer.x.com  (OAuth 2.0, Web App)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202606

# Meta (Facebook Pages + Instagram business accounts): https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
# Connecting asks for Facebook Page permissions only. After your Meta app has been given
# instagram_basic and instagram_content_publish, set this to also connect linked Instagram accounts.
# META_INSTAGRAM=true
# Or list the exact permissions to request (comma separated). Overrides the above.
# META_SCOPES=

# Threads: https://developers.facebook.com/apps (Threads API use case)
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- Google Drive (optional): "Add from Google Drive" on the Images page ----
# https://console.cloud.google.com  Enable the Drive API and Picker API, then create an OAuth client ID
# (Web application, with PUBLIC_URL as an Authorized JavaScript origin) and an API key restricted to
# this website and the Picker API. Both values are sent to the browser, so restrict them.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=

# Bluesky and Mastodon need no app keys. Connect them from the Accounts page.
